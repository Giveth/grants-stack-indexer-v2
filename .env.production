# Production Environment Configuration for DigitalOcean Deployment
# Copy this to .env and update the values for your production environment

######################################################
############### DOMAIN & SSL CONFIGURATION ###########
######################################################
DOMAIN=your-domain.com
EMAIL=your-email@domain.com
# Comma-separated list of admin IPs for admin interface access
ADMIN_IPS=your.admin.ip.address,another.admin.ip

######################################################
############### DATALAYER DATABASE (MANAGED) #########
######################################################
# Use DigitalOcean Managed Database connection details
DATALAYER_PG_HOST=your-datalayer-db-host.db.ondigitalocean.com
DATALAYER_PG_PORT=25060
DATALAYER_PG_USER=doadmin
DATALAYER_PG_PASSWORD=your-secure-password
DATALAYER_PG_DATABASE=datalayer

######################################################
############### INDEXER DATABASE (MANAGED) ###########
######################################################
# Use DigitalOcean Managed Database connection details
ENVIO_PG_HOST=your-indexer-db-host.db.ondigitalocean.com
ENVIO_PG_PORT=25060
ENVIO_PG_USER=doadmin
ENVIO_PG_PASSWORD=your-secure-password
ENVIO_PG_DATABASE=indexer

######################################################
############### DATALAYER HASURA API #################
######################################################
DATALAYER_HASURA_ADMIN_SECRET=your-super-secure-admin-secret-here
DATALAYER_HASURA_UNAUTHORIZED_ROLE=public
DATALAYER_HASURA_CORS_DOMAIN=https://your-domain.com,https://indexer.your-domain.com

######################################################
############### INDEXER HASURA API ###################
######################################################
HASURA_GRAPHQL_ADMIN_SECRET=your-super-secure-admin-secret-here
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=public

######################################################
############### BLOCKCHAIN CONFIGURATION #############
######################################################
# Optimism mainnet configuration with multiple RPC endpoints for reliability
CHAINS=[{"id":10,"name":"optimism","rpcUrls":["https://optimism.llamarpc.com","https://rpc.ankr.com/optimism","https://optimism.gateway.tenderly.co","https://optimism.blockpi.network/v1/rpc/public","https://mainnet.optimism.io"],"fetchLimit":5000,"fetchDelayMs":1000}]

######################################################
############### METADATA CONFIGURATION ###############
######################################################
METADATA_SOURCE=public-gateway
PUBLIC_GATEWAY_URLS=["https://ipfs.io","https://dweb.link","https://cloudflare-ipfs.com","https://gateway.pinata.cloud","https://ipfs.infura.io","https://ipfs.fleek.co","https://ipfs.eth.aragon.network"]

######################################################
############### RETRY CONFIGURATION ##################
######################################################
RETRY_MAX_ATTEMPTS=10
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=1000
RETRY_FACTOR=1.5

######################################################
############### PRICING CONFIGURATION ################
######################################################
PRICING_SOURCE=coingecko
# Get your API key from https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your-coingecko-api-key-here
COINGECKO_API_TYPE=pro

######################################################
############### LOGGING & MONITORING #################
######################################################
# Set to false for production
HASURA_GRAPHQL_DEV_MODE=false
HASURA_GRAPHQL_ENABLE_CONSOLE=false

# Log levels: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
